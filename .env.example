# Browser key: Maps JavaScript API (+ Places library), restricted to the site address.
GOOGLE_MAPS_BROWSER_KEY=
# Server key: Places API (New) only, kept secret. Used for place search in the admin area.
GOOGLE_MAPS_SERVER_KEY=
# The Curator's admin password.
ADMIN_PASSWORD=
# Long random string that signs the session cookie, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=
# The address share links point at, e.g. https://cafeandwifi.example. Blank uses the address the site was reached on.
SITE_URL=
# SQLite database file. Blank uses cafes.db in the project root.
DATABASE=
